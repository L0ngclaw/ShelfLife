rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }
    function isInvitedTo(hid) {
      return signedIn() &&
        get(/databases/$(database)/documents/invites/$(hid + '_' + myEmail())).data.status == 'pending';
    }

    // Private pantry: only the owner (offline-first data, synced as a backup)
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Households: only members can see them; an invited user may add themselves
    match /households/{hid} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && (request.auth.uid in resource.data.members || isInvitedTo(hid));

      // Shared data of the household: requests and the family shelf
      match /{collection}/{docId} {
        allow read, write: if isMember(hid);
      }
    }

    // In-app invites: created by members, read and answered by the invited user
    match /invites/{inviteId} {
      allow list: if signedIn() && resource.data.toEmail == myEmail();
      allow get: if signedIn() && (resource.data.toEmail == myEmail() || isMember(resource.data.householdId));
      allow create: if isMember(request.resource.data.householdId);
      allow update: if signedIn() &&
        (resource.data.toEmail == myEmail() || isMember(resource.data.householdId));
    }
  }
}
